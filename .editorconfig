root = true

[*]
charset = utf-8-bom
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4
tab_width = 4

[*.cs]
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_new_line_before_members_in_chained_calls = true
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion

[*.{json,jsonc}]
indent_size = 2

# This single placeholder is intentionally skipped until the isolated COM harness exists.
# 这个唯一的占位测试必须显式跳过，直到隔离的 COM Live harness 建立完成。
[tests/SolidWorksMcp.LiveSolidWorksTests/LivePlaceholderTests.cs]
dotnet_diagnostic.xUnit1004.severity = none

[*.md]
trim_trailing_whitespace = false
