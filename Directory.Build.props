<Project>
  <PropertyGroup>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <RepositoryUrl>https://github.com/lqepoch/solidworks_mcp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!--
      Keep generated files out of SDK default globs even when an alternate output root is selected.
      当选择备用输出根目录时，也要显式排除生成文件，避免多次构建的 AssemblyInfo 被再次编译。
    -->
    <DefaultItemExcludes>$(DefaultItemExcludes);**/bin/**;**/obj/**;artifacts/**</DefaultItemExcludes>
    <!-- Hosted CI opts into project-scoped ignored output roots so it cannot overwrite local native assets. -->
    <!-- Hosted CI 显式启用按项目隔离的 ignored 输出根目录，不能覆盖本机 native assets。 -->
    <SolidWorksMcpHostedBuild Condition="'$(SolidWorksMcpHostedBuild)' == ''">false</SolidWorksMcpHostedBuild>
    <BaseOutputPath Condition="'$(SolidWorksMcpHostedBuild)' == 'true'">$(MSBuildThisFileDirectory)artifacts\hosted\bin\$(MSBuildProjectName)\</BaseOutputPath>
    <BaseIntermediateOutputPath Condition="'$(SolidWorksMcpHostedBuild)' == 'true'">$(MSBuildThisFileDirectory)artifacts\hosted\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <!--
    Import only the optional user-local properties generated by the Windows doctor.
    只导入 Windows doctor 生成的可选用户本地属性；仓库不保存机器绝对路径。
  -->
  <PropertyGroup>
    <SolidWorksMcpLocalProps Condition="'$(SolidWorksMcpLocalProps)' == '' and '$(LOCALAPPDATA)' != ''">$(LOCALAPPDATA)\SolidWorksMcp\SolidWorksMcp.local.props</SolidWorksMcpLocalProps>
  </PropertyGroup>
  <Import Project="$(SolidWorksMcpLocalProps)" Condition="'$(SolidWorksMcpLocalProps)' != '' and Exists('$(SolidWorksMcpLocalProps)')" />
</Project>
