<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>SolidWorksMcp.Server</RootNamespace>
    <AssemblyName>SolidWorksMcp.Server</AssemblyName>
    <!-- The native provider is opt-in through user-local doctor output; Hosted CI leaves this false. -->
    <!-- 原生 Provider 由用户本地 doctor 输出显式 opt-in；Hosted CI 保持 false。 -->
    <SolidWorksMcpNativeProviderEnabled Condition="'$(SolidWorksMcpNativeProviderEnabled)' == ''">false</SolidWorksMcpNativeProviderEnabled>
    <TargetFrameworks Condition="'$(SolidWorksMcpNativeProviderEnabled)' == 'true'">net10.0;net10.0-windows</TargetFrameworks>
    <TargetFrameworks Condition="'$(SolidWorksMcpNativeProviderEnabled)' != 'true'">net10.0</TargetFrameworks>
    <EnableWindowsTargeting Condition="'$(SolidWorksMcpNativeProviderEnabled)' == 'true'">true</EnableWindowsTargeting>
    <DefineConstants Condition="'$(SolidWorksMcpNativeProviderEnabled)' == 'true' and '$(TargetFramework)' == 'net10.0-windows'">$(DefineConstants);SOLIDWORKS_MCP_NATIVE_PROVIDER</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="ModelContextProtocol" />
    <ProjectReference Include="..\SolidWorksMcp.Core\SolidWorksMcp.Core.csproj" />
    <ProjectReference Include="..\SolidWorksMcp.Protocol\SolidWorksMcp.Protocol.csproj" />
    <ProjectReference Include="..\SolidWorksMcp.CadAbstractions\SolidWorksMcp.CadAbstractions.csproj" />
    <ProjectReference Include="..\SolidWorksMcp.EngineeringModel\SolidWorksMcp.EngineeringModel.csproj" />
    <ProjectReference Include="..\SolidWorksMcp.RuleEngine\SolidWorksMcp.RuleEngine.csproj" />
    <ProjectReference Include="..\SolidWorksMcp.Tolerancing\SolidWorksMcp.Tolerancing.csproj" />
    <ProjectReference Include="..\SolidWorksMcp.AutoDrawing\SolidWorksMcp.AutoDrawing.csproj" />
    <ProjectReference Include="..\SolidWorksMcp.AssemblyDrawing\SolidWorksMcp.AssemblyDrawing.csproj" />
    <!-- This is an assembly boundary, not a vendor COM reference. The provider project owns all Interop references. -->
    <!-- 这是 assembly 边界而不是厂商 COM 引用；所有 Interop 引用仍归 Provider 项目所有。 -->
    <ProjectReference Include="..\..\providers\SolidWorksMcp.Provider.SolidWorks\SolidWorksMcp.Provider.SolidWorks.csproj" Condition="'$(SolidWorksMcpNativeProviderEnabled)' == 'true' and '$(TargetFramework)' == 'net10.0-windows'" />
  </ItemGroup>
</Project>
